{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-vercel",
    "skipLibCheck": true
  },
  "include": [
    "api/mcp.ts",
    "src/mcpHandler.ts"
  ],
  "exclude": [
    "dist",
    "scripts/**/*",
    "src/index*.ts",
    "src/mcp-server*.ts",
    "src/cloudflare-worker*.ts",
    "src/api/context.ts",
    "src/db/**/*",
    "src/services/**/*",
    "src/middleware/**/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    ".tmp-mcp-check.ts",
    "node_modules"
  ]
}

