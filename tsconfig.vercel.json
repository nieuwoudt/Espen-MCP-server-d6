{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist-vercel",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["api/mcp.ts", "src/mcpHandler.ts"],
  "exclude": ["node_modules"]
}
