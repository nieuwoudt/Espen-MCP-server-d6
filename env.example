# 🌍 Environment Configuration for Espen D6 MCP Server

# 🔐 Server Configuration
PORT=3000
NODE_ENV=development
ESPEN_ENV=development
JWT_SECRET=your-super-secret-jwt-key-here

# 🚀 Production Settings (for Vercel deployment)
# NODE_ENV=production
# ESPEN_ENV=production
# D6_MOCK_MODE=false

# 📊 Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 🏫 D6 API Configuration (v2 - Integrate API)
# IMPORTANT: Use the correct D6 Integrate API base URL
D6_API_BASE_URL=https://integrate.d6plus.co.za/api
D6_API_USERNAME=your-d6-username
D6_API_PASSWORD=your-d6-password
D6_MOCK_MODE=false
D6_REQUEST_TIMEOUT=30000

# 🏫 Multi-School Configuration (17 authorized schools)
# Comma-separated list of school login IDs that are allowed to access the MCP server
D6_ALLOWED_SCHOOL_LOGIN_IDS=1450,1376,2100,1352,1674,3118,3664,2240,2219,1367,1483,1875,2752,1479,1430,3652,1431

# School ID to Name mapping for better logging and identification
# Format: school_login_id:School Name,school_login_id:School Name,...
D6_SCHOOL_MAP=1450:Laerskool Bergsig,1376:Laerskool Louis Leipoldt,2100:Laerskool Gericke Primary,1352:Laerskool Monumentpark,1674:Hoërskool Klerksdorp,3118:Laerskool Bredasdorp Primary School,3664:Laerskool Oranje-Noord,2240:Xanadu Private School,2219:Rietvlei Akademie Lyttelton,1367:Laerskool Tzaneen Primary,1483:Laerskool Kruinsig,1875:Laerskool Unika,2752:Kleinspoortjies Hennopspark (Pty) Ltd,1479:Laerskool Boerefort,1430:Hoërskool Brits,3652:Laerskool Eureka Kimberley,1431:Laerskool Hennopspark

# Legacy support (for backward compatibility)
D6_MONUMENTPARK_SCHOOL_LOGIN_ID=1352

# 💾 Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_DEFAULT=3600

# 📝 Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# 🚦 Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# 🔄 Sync Configuration
SYNC_INTERVAL_MINUTES=15
SYNC_RETRY_ATTEMPTS=3
SYNC_BATCH_SIZE=100
SYNC_ON_STARTUP=false

# 📊 Performance Configuration
CACHE_TTL_CONTEXT=300
CACHE_TTL_LEARNER_DATA=1800
CACHE_TTL_MARKS=900 